{
  "name": "prg-viewer",
  "version": "0.3.0",
  "private": true,
  "description": "Open Project Graph .prg canvas files in a read-only viewer with nodes, edges, images, LaTeX and sections.",
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-isolation=none \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch --test-isolation=none \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:coverage": "node --test --test-isolation=none --experimental-test-coverage --test-coverage-lines=85 --test-coverage-functions=85 --test-coverage-branches=75 \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "inspect": "node --experimental-strip-types scripts/inspect-prg.ts",
    "fixture": "node --experimental-strip-types scripts/make-fixture.ts",
    "bump": "node --experimental-strip-types scripts/bump-version.ts",
    "check:version": "node --experimental-strip-types scripts/check-version.ts",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "fflate": "^0.8.3",
    "katex": "^0.16.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "obsidian": "^1.7.2",
    "prettier": "^3.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.24.0"
  }
}
